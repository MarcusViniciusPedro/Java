<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.marcus.mercadinho.controller.CadFornecedorController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Cadastro de Fornecedores">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
      <Label text="CNPJ" />
      <TextField fx:id="cnpjField" />
      <Label text="Nome Fantasia" />
      <TextField fx:id="nomefantasiaField" />
      <Label text="Telefone" />
      <TextField fx:id="telefoneField" />
      <Button onAction="#CadastrarCliqueF" text="Cadastrar">
         <font>
            <Font size="15.0" />
         </font>
      </Button>
      <Label prefHeight="18.0" prefWidth="323.0" text="Caso queira Cadastrar um produto clique no botão abaixo" />
      <Button mnemonicParsing="false" onAction="#CadastrarProdutoF" text="Cadastrar Produto">
         <font>
            <Font size="15.0" />
         </font>
      </Button>
   </children>
</VBox>

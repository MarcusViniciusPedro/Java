<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<VBox alignment="CENTER" prefHeight="400.0" prefWidth="400.0" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.igor.pizzaria.controller.MenuPrincipalController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Sistema Pizzaria">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>

    <Button mnemonicParsing="false" onAction="#abrirCadastroCategoria" prefWidth="200.0" text="Cadastrar Categoria" />
    <Button mnemonicParsing="false" onAction="#abrirCadastroProduto" prefWidth="200.0" text="Cadastrar Produto" />
    <Button mnemonicParsing="false" onAction="#abrirLista" prefWidth="200.0" text="Listar Produtos" />
</VBox>
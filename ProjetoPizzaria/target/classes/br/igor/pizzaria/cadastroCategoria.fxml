<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>
<VBox alignment="CENTER_LEFT" prefHeight="400.0" prefWidth="400.0" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.igor.pizzaria.controller.CadastroCategoriaController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Nova Categoria">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <Label text="Nome da Categoria:" />
    <TextField fx:id="txtNomeCategoria" promptText="Ex: Bebidas, Pizzas Doces" />

    <HBox spacing="10.0">
        <Button mnemonicParsing="false" onAction="#voltarMenu" text="Voltar" />
        <Button mnemonicParsing="false" onAction="#salvarCategoria" text="Salvar Categoria" />
    </HBox>
</VBox>
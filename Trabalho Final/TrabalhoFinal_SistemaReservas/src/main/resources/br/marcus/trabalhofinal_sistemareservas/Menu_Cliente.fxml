      </Button>
      <Button layoutX="262.0" layoutY="303.0" mnemonicParsing="false" onAction="#irCadastroReserva" prefHeight="47.0" prefWidth="200.0" style="-fx-background-color: #E52421;" text="Reserve Já!" textFill="WHITE">
         <font>
            <Font name="Gentium Book Basic" size="18.0" />

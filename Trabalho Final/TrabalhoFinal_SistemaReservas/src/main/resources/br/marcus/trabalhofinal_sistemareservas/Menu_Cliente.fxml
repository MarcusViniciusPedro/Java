      </Button>
      <Button layoutX="471.0" layoutY="306.0" mnemonicParsing="false" onAction="#irTelaIncial" prefHeight="39.0" prefWidth="77.0" style="-fx-background-color: #19B5B5;" text="Voltar" textFill="WHITE">

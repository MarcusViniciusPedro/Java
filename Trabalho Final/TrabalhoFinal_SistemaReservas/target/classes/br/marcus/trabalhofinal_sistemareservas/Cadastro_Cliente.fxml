<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.marcus.trabalhofinal_sistemareservas.controller.CadClienteController">
   <children>
      <ImageView fitHeight="400.0" fitWidth="720.0">
         <image>
            <Image url="@Images/CadCliente.png" />
         </image>
      </ImageView>
      <Button layoutX="662.0" layoutY="14.0" mnemonicParsing="false" onAction="#voltarTelaIntroducao" prefHeight="26.0" prefWidth="58.0" style="-fx-background-color: #D28C47;" text="Sair" textFill="WHITE">
         <font>
            <Font name="Gentium Book Basic" size="13.0" />
         </font>
      </Button>
      <Button layoutX="257.0" layoutY="301.0" mnemonicParsing="false" onAction="#irMenuCliente" prefHeight="50.0" prefWidth="175.0" style="-fx-background-color: #E52421;" text="Cadastrar" textFill="WHITE">
         <font>
            <Font name="Gentium Book Basic" size="15.0" />
         </font>
      </Button>
      <Button layoutX="440.0" layoutY="304.0" mnemonicParsing="false" onAction="#irTelaInicial" prefHeight="46.0" prefWidth="75.0" style="-fx-background-color: #19B5B5;" text="Voltar" textFill="WHITE">
         <font>
            <Font name="Gentium Book Basic" size="15.0" />
         </font>
      </Button>
      <TextField fx:id="nomeField" layoutX="165.0" layoutY="148.0" prefHeight="27.0" prefWidth="197.0" />
      <TextField fx:id="idadeField" layoutX="165.0" layoutY="206.0" prefHeight="27.0" prefWidth="197.0" />
      <TextField fx:id="cpfField" layoutX="166.0" layoutY="264.0" prefHeight="26.0" prefWidth="196.0" />
      <TextField fx:id="emailField" layoutX="436.0" layoutY="147.0" prefHeight="28.0" prefWidth="193.0" />
      <TextField fx:id="telefoneField" layoutX="436.0" layoutY="205.0" prefHeight="28.0" prefWidth="194.0" />
      <PasswordField fx:id="senhaField" layoutX="436.0" layoutY="263.0" prefHeight="27.0" prefWidth="193.0" />
   </children>
</AnchorPane>
